# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://mural:mural@localhost:5432/livingmural

# Redis
REDIS_URL=redis://localhost:6379

# Auth — set a real secret in production
JWT_SECRET=change-me-in-production

# Stripe (brush purchases) — leave unset to disable purchases
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Archival: local | ipfs (ipfs needs a provider below)
ARCHIVE_PROVIDER=local
ARCHIVE_BASE_URL=http://localhost:4000

# Dev-only testing flags — NEVER enable in production
ALLOW_DEV_LOGIN=false
SKIP_ACCOUNT_AGE_GATE=false

# IPFS Hall of Fame (when ready — Pinata / web3.storage / Kubo)
# IPFS_PROVIDER_URL=
# IPFS_API_KEY=
# IPFS_API_SECRET=
