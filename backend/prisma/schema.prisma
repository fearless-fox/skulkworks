generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  walletAddress String?        @unique
  displayName   String
  avatar        String?
  createdAt     DateTime       @default(now())
  banned        Boolean        @default(false)

  contributions Transaction[]
  stickers      Sticker[]
  canvases      Canvas[]       @relation("CanvasCreator")
}

model Canvas {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  creatorId   String
  creator     User      @relation("CanvasCreator", fields: [creatorId], references: [id])

  epoch       Epoch?
  transactions Transaction[]
  stickers    Sticker[]
}

model Epoch {
  id        String   @id @default(uuid())
  canvasId  String   @unique
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  state     EpochState @default(OPEN)
  endsAt    DateTime
  archiveAt DateTime?
  archiveUrl String?
  createdAt DateTime @default(now())
}

enum EpochState {
  OPEN
  READ_ONLY
  ARCHIVED
}

model Transaction {
  id        String   @id @default(uuid())
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  userId    String
  artist    User     @relation(fields: [userId], references: [id])
  type      TransactionType
  timestamp DateTime @default(now())
  payload   Json

  @@index([canvasId, timestamp])
  @@index([userId])
}

enum TransactionType {
  stroke
  image
  delete
}

model Sticker {
  id              String   @id @default(uuid())
  canvasId        String
  canvas          Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id])
  assetId         String
  parentArtworkId String?
  transform       Json
  zIndex          Int      @default(0)
  createdAt       DateTime @default(now())
}
